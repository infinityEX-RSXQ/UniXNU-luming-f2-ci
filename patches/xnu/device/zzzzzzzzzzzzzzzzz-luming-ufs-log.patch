+#define LUMING_LOG_BYTES (256 * 1024)
+char luming_log_ring[LUMING_LOG_BYTES];
+volatile size_t luming_log_len;
+volatile int luming_log_enabled;
+volatile int luming_log_open_status;
+volatile uint64_t luming_log_first_lba;
+volatile long long luming_log_value;
+
+extern int native_ufs_log_write(uint64_t rel, uint32_t blocks, const void *src);
+extern int native_ufs_log_sync(void);
+
+void
+luming_log_flush(const char *reason)
+{
+	if (!luming_log_enabled) {
+		return;
+	}
+	static uint8_t header[4096];
+	static const char magic[8] = { 'L', 'U', 'M', 'I', 'N', 'G', 'L', '1' };
+	size_t len = luming_log_len;
+	if (len > LUMING_LOG_BYTES) {
+		len = LUMING_LOG_BYTES;
+	}
+	__builtin_memset(header, 0, sizeof(header));
+	__builtin_memcpy(header, magic, sizeof(magic));
+	__builtin_memcpy(header + 8, &len, sizeof(len));
+	int status = luming_log_open_status;
+	__builtin_memcpy(header + 24, &status, sizeof(status));
+	uint64_t first = luming_log_first_lba;
+	__builtin_memcpy(header + 32, &first, sizeof(first));
+	long long value = luming_log_value;
+	__builtin_memcpy(header + 40, &value, sizeof(value));
+	if (reason) {
+		size_t n = 0;
+		while (n < 128 && reason[n]) {
+			header[64 + n] = (uint8_t)reason[n];
+			n++;
+		}
+	}
+	uint32_t blocks = (uint32_t)((len + 4095) / 4096);
+	if (!native_ufs_log_write(0, 1, header)) {
+		return;
+	}
+	static uint8_t tail[4096];
+	for (uint32_t i = 0; i < blocks; i++) {
+		uint32_t offset = i * 4096;
+		uint32_t remaining = (uint32_t)len - offset;
+		if (remaining >= 4096) {
+			if (!native_ufs_log_write(1 + i, 1, luming_log_ring + offset)) {
+				return;
+			}
+		} else {
+			__builtin_memset(tail, 0, sizeof(tail));
+			__builtin_memcpy(tail, luming_log_ring + offset, remaining);
+			if (!native_ufs_log_write(1 + i, 1, tail)) {
+				return;
+			}
+		}
+	}
+	native_ufs_log_sync();
+}
+
 void
 cons_putc_locked(char c)
 {
 	console_write_char(c);
+	if (luming_log_enabled) {
+		size_t at = luming_log_len;
+		if (at < LUMING_LOG_BYTES) {
+			luming_log_ring[at] = c;
+			luming_log_len = at + 1;
+		}
+	}
 }
 
