diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1813,12 +1813,18 @@
 		printf("Generated core file for pid: %d in %d.%03d seconds\n",
 		    proc_getpid(p), (uint32_t)tv_sec, tv_msec);
 	}
 #endif /* (DEVELOPMENT || DEBUG) && CONFIG_COREDUMP */
 }
 
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+extern volatile int native_owner_cache_stage;
+extern volatile int native_owner_cache_status;
+extern char native_owner_cache_device_path[64];
+#endif
+
 static void
 proc_handle_critical_exit(proc_t p, int rv)
 {
 	if (!proc_should_trigger_panic(p, rv)) {
 		// No panic, bail out
 		return;
@@ -1852,12 +1858,18 @@
 			prefix_str = "LTE preinit process exited";
 		} else if (initproc_spawned) {
 			prefix_str = "initproc exited";
 		} else {
 			prefix_str = "initproc failed to start";
 		}
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+		snprintf(prefix_str_buf, sizeof(prefix_str_buf), "%s [cache %d/%d %s]",
+		    prefix_str, native_owner_cache_stage, native_owner_cache_status,
+		    native_owner_cache_device_path);
+		prefix_str = prefix_str_buf;
+#endif
 	} else {
 		/* For processes that aren't launchd, just use the process name and pid */
 		snprintf(prefix_str_buf, sizeof(prefix_str_buf), "%s[%d] exited", p->p_name, proc_getpid(p));
 		prefix_str = prefix_str_buf;
 	}
 
