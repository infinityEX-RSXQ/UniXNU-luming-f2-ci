 #include <sys/types.h>
 #include <sys/kdebug.h>
 #include <mach/vm_param.h>
+#include <vm/vm_kern.h>
 #include <pexpert/protos.h>
 #include <pexpert/pexpert.h>
 #include <pexpert/boot.h>
 #include <pexpert/device_tree.h>
@@ -519,8 +520,21 @@
 void
 PE_create_console(void)
 {
 	/*
+	 * luming: arm_init() calls PE_create_console() before Mach VM exists,
+	 * while kernel_map is still VM_MAP_NULL. The video path then reaches
+	 * initialize_screen() -> ml_io_map_unmappable() -> io_map(), which
+	 * cannot allocate the framebuffer mapping without kernel_map (and the
+	 * 4 KiB bootstrap tables do not necessarily contain a PTE for the
+	 * framebuffer KVA). Defer the real console creation until the first
+	 * call made after vm_mem_bootstrap()/console_init() in kernel_bootstrap.
+	 */
+	if (kernel_map == VM_MAP_NULL) {
+		return;
+	}
+
+	/*
 	 * Check the head of VRAM for a panic log saved on last panic.
 	 * Do this before the VRAM is trashed.
 	 */
 	check_for_panic_log();
