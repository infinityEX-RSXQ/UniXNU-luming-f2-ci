+#if XNU_QCOM_USB_DEBUG
+/* Exactly the Mach-private prototypes the worker needs, spelled here because
+ * this translation unit does not define MACH_KERNEL_PRIVATE (checked in
+ * bsd/DEVELOPMENT/bsd_init.o.json).  Using the real headers instead would
+ * change this unit's header ABI for unrelated code. */
+extern processor_t thread_bind(processor_t processor);
+extern void thread_terminate_self(void);
+
+/* Late scheduler service for an already running controller: no device
+ * initialization, allocation, IRQ handler, filesystem or display dependency.
+ * States: 0 unstarted, 1 creating, 2 running, 3 start/bind failure, 4 stopped.
+ */
+static unsigned int qcom_usb_worker_state;
+/* Reboot states: 0 unstarted, 1 creating, 2 active, 3 start failure, 4 ended. */
+static unsigned int qcom_usb_reboot_state;
+
+/* The USB worker keeps running while this separate normal thread waits for the
+ * acknowledged frame and queued console bytes to leave the CDC transport, then
+ * reaches reboot_kernel through the regular shutdown path. */
+static void
+qcom_usb_reboot_worker(void *argument __unused, wait_result_t result __unused)
+{
+	processor_t processor = cpu_to_processor(master_cpu);
+	int reboot_result;
+
+	thread_set_thread_name(current_thread(), "qcom-usb-reboot");
+	if (processor == PROCESSOR_NULL) {
+		qcom_usb_debug_control_reboot_failed(-1);
+		goto out;
+	}
+	thread_bind(processor);
+	thread_block(THREAD_CONTINUE_NULL);
+	if (cpu_number() != master_cpu) {
+		qcom_usb_debug_control_reboot_failed(-2);
+		goto out;
+	}
+	if (!qcom_usb_debug_wait_drained(2000)) {
+		qcom_usb_debug_control_reboot_failed(-3);
+		goto out;
+	}
+	if (!qcom_usb_debug_control_arm_reboot()) {
+		qcom_usb_debug_control_reboot_failed(-4);
+		goto out;
+	}
+	/* Reset directly instead of through reboot_kernel. Measured 2026-10-27:
+	 * reboot_kernel unmounts every filesystem first, and vfs_unmountall panics on this
+	 * board inside apfs_unmount's vflush (vnode_rele_ext usecount -ve at vfs_subr.c:2692),
+	 * because the SystemOS union mount drops one reference on the root vnode too many.
+	 * That panic lands before the reset, so the IMEM reason cell never gets written and
+	 * the phone cannot return to fastboot. This path writes the cell and resets with no
+	 * filesystem work. It does not return. */
+	(void)reboot_result;
+	qcom_usb_debug_control_reset_now();
+
+out:
+	__atomic_store_n(&qcom_usb_reboot_state, 4u, __ATOMIC_RELEASE);
+	thread_bind(PROCESSOR_NULL);
+	thread_terminate_self();
+}
+
+static void
+qcom_usb_start_reboot_once(void)
+{
+	thread_t thread = THREAD_NULL;
+	unsigned int state, running = 1u;
+	kern_return_t result;
+
+	if (!qcom_usb_debug_control_take_reboot()) {
+		return;
+	}
+	for (;;) {
+		state = __atomic_load_n(&qcom_usb_reboot_state, __ATOMIC_ACQUIRE);
+		if (state != 0u && state != 3u && state != 4u) {
+			/* A live request stays strictly single-instance; a completed
+			 * failure may be reused by a fresh request.
+			 */
+			qcom_usb_debug_control_reboot_failed(-6);
+			return;
+		}
+		if (__atomic_compare_exchange_n(&qcom_usb_reboot_state, &state, 1u,
+		    0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			break;
+		}
+	}
+	result = kernel_thread_start(qcom_usb_reboot_worker, NULL, &thread);
+	if (result == KERN_SUCCESS) {
+		(void)__atomic_compare_exchange_n(&qcom_usb_reboot_state, &running,
+		    2u, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+		thread_deallocate(thread);
+	} else {
+		__atomic_store_n(&qcom_usb_reboot_state, 3u, __ATOMIC_RELEASE);
+		qcom_usb_debug_control_reboot_failed(result);
+		kprintf("QCOM USB REBOOT start failed kr=%d\n", result);
+	}
+}
+
+static void
+qcom_usb_worker_wait(void)
+{
+	uint64_t deadline;
+
+	/* Unlike delay_for_interval this never selects a CPU-latency spin path.
+	 * Reached only in normal thread context, with preemption enabled and
+	 * outside every USB guard.
+	 */
+	clock_interval_to_deadline(5, NSEC_PER_MSEC, &deadline);
+	if (assert_wait_deadline((event_t)&qcom_usb_worker_state,
+	    THREAD_UNINT, deadline) == THREAD_WAITING) {
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* Independent, opt-in, bounded stackshot producer.  It never panics and
+ * never touches the USB controller; the existing worker drains the FIFO. */
+static unsigned int qcom_rawshot_started;
+static void
+qcom_rawshot_delay(unsigned seconds)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	if (assert_wait_deadline((event_t)&qcom_rawshot_started,
+	    THREAD_UNINT, deadline) == THREAD_WAITING) {
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* A busy producer may reject the whole record. Retry only a zero-byte
+ * rejection; a partial record is reported as loss and never duplicated. */
+static int
+qcom_rawshot_write(const char *bytes, size_t length)
+{
+	for (unsigned retry = 0; retry < 100; ++retry) {
+		size_t written = qcom_usb_debug_enqueue(bytes, length);
+		if (written == length) return 1;
+		if (written != 0) return 0;
+		uint64_t deadline;
+		clock_interval_to_deadline(1, NSEC_PER_MSEC, &deadline);
+		if (assert_wait_deadline((event_t)&qcom_rawshot_started,
+		    THREAD_UNINT, deadline) == THREAD_WAITING) thread_block(THREAD_CONTINUE_NULL);
+	}
+	return 0;
+}
+
+static void
+qcom_rawshot_worker(void *argument __unused, wait_result_t result __unused)
+{
+	const uint32_t capacity = 1024u * 1024u;
+	const uint64_t flags = 0x10000ULL | 0x2ULL | 0x8ULL | 0x100000ULL |
+	    0x800000ULL | 0x1000000ULL | 0x40000000ULL | 0x400000000ULL;
+	uint8_t *buffer;
+	thread_set_thread_name(current_thread(), "qcom-usb-rawshot");
+	qcom_rawshot_delay(60);
+	buffer = kalloc_data(capacity, Z_WAITOK | Z_ZERO);
+	if (!buffer) {
+		kprintf("QCOM RAWSHOT allocation failed\n");
+		thread_terminate_self();
+	}
+	for (unsigned sample = 0; sample < 2; ++sample) {
+		char line[192];
+		unsigned used = 0, failed = 0;
+		uint32_t fnv = 2166136261u;
+		kern_return_t rc = stack_snapshot_from_kernel(-1, buffer, capacity,
+		    flags, 0, 0, &used);
+		int n = snprintf(line, sizeof(line), "\nQRAWSHOT BEGIN s=%u rc=%x bytes=%u\n", sample, rc, used);
+		if (n <= 0 || (size_t)n >= sizeof(line) || !qcom_rawshot_write(line, (size_t)n)) ++failed;
+		if (rc == KERN_SUCCESS && used <= capacity) {
+			static const char hex[] = "0123456789abcdef";
+			for (unsigned off = 0; off < used; off += 64) {
+				unsigned len = used - off < 64 ? used - off : 64;
+				n = snprintf(line, sizeof(line), "\nQRAWSHOT D s=%u off=%x hex=", sample, off);
+				if (n <= 0 || (size_t)n + 2u * len + 1u >= sizeof(line)) { ++failed; break; }
+				for (unsigned j = 0; j < len; ++j) {
+					uint8_t b = buffer[off + j];
+					fnv = (fnv ^ b) * 16777619u;
+					line[n++] = hex[b >> 4]; line[n++] = hex[b & 15u];
+				}
+				line[n++] = '\n';
+				if (!qcom_rawshot_write(line, (size_t)n)) ++failed;
+			}
+		}
+		n = snprintf(line, sizeof(line), "\nQRAWSHOT END s=%u bytes=%u fail=%u fnv=%08x\n", sample, used, failed, fnv);
+		if (n > 0 && (size_t)n < sizeof(line)) (void)qcom_rawshot_write(line, (size_t)n);
+		if (sample == 0) qcom_rawshot_delay(15);
+	}
+	kfree_data(buffer, capacity);
+	thread_terminate_self();
+}
+
+static void
+qcom_rawshot_start_once(void)
+{
+	int enabled = 0;
+	unsigned expected = 0;
+	thread_t thread = THREAD_NULL;
+	if (!PE_parse_boot_argn("qcom-usb-rawshot", &enabled, sizeof(enabled)) || enabled != 1) return;
+	if (!__atomic_compare_exchange_n(&qcom_rawshot_started, &expected, 1u, 0,
+	    __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) return;
+	kern_return_t kr = kernel_thread_start(qcom_rawshot_worker, NULL, &thread);
+	if (kr == KERN_SUCCESS) thread_deallocate(thread);
+	else kprintf("QCOM RAWSHOT thread failed kr=%d\n", kr);
+}
+
+static void
+qcom_usb_worker(void *argument __unused, wait_result_t result __unused)
+{
+	struct qcom_usb_debug_status status = {0};
+	processor_t processor = cpu_to_processor(master_cpu);
+	int control_enabled = 0;
+	int control_active = 0;
+	int heartbeat_enabled = 0;
+	uint64_t heartbeat_deadline = 0;
+
+	thread_set_thread_name(current_thread(), "qcom-usb-debug");
+	/* Bind the way sched_prim.c binds its master-processor threads, then
+	 * prove the migration happened: master_cpu need not be logical CPU 0.
+	 * The module serves hardware only from the CPU it captured at init.
+	 */
+	if (processor == PROCESSOR_NULL) {
+		__atomic_store_n(&qcom_usb_worker_state, 3u, __ATOMIC_RELEASE);
+		kprintf("QCOM USB WORKER master processor missing cpu=%d\n", master_cpu);
+		goto stopped;
+	}
+	thread_bind(processor);
+	thread_block(THREAD_CONTINUE_NULL);
+	if (cpu_number() != master_cpu) {
+		__atomic_store_n(&qcom_usb_worker_state, 3u, __ATOMIC_RELEASE);
+		kprintf("QCOM USB WORKER bind failed cpu=%d master=%d\n", cpu_number(), master_cpu);
+		goto stopped;
+	}
+
+	qcom_usb_debug_get_status(&status);
+	if (status.phase != QCOM_USB_DEBUG_ACTIVE) {
+		kprintf("QCOM USB WORKER unavailable phase=%u error=%u\n", status.phase, status.error);
+		goto stopped;
+	}
+	__atomic_store_n(&qcom_usb_worker_state, 2u, __ATOMIC_RELEASE);
+	qcom_rawshot_start_once();
+	(void)PE_parse_boot_argn("qcom-usb-heartbeat", &heartbeat_enabled, sizeof(heartbeat_enabled));
+	kprintf("QCOM USB WORKER active cpu=%d period_ms=5 buffer=%llu\n",
+	    cpu_number(), status.buffer_capacity);
+	/* Read the control opt-in here, in normal thread context only.  The
+	 * default profile installs no callback and consumes no action.
+	 */
+	if (PE_parse_boot_argn("qcom-usb-ctl", &control_enabled, sizeof(control_enabled)) &&
+	    control_enabled == 1) {
+		if (!qcom_usb_debug_control_start()) {
+			kprintf("QCOM USB CONTROL unavailable\n");
+		} else {
+			control_active = 1;
+			qcom_usb_debug_get_status(&status);
+			kprintf("QCOM USB CONTROL active hook=%u\n", status.control_hook_owned);
+		}
+	}
+	for (;;) {
+		/* The panic hook keeps its own separate bounded drain. */
+		if (panic_active()) {
+			break;
+		}
+		qcom_usb_debug_get_status(&status);
+		if (status.phase != QCOM_USB_DEBUG_ACTIVE) {
+			break;
+		}
+		if (heartbeat_enabled == 1 &&
+		    (!heartbeat_deadline || mach_absolute_time() >= heartbeat_deadline)) {
+			static const char heartbeat[] = "\nQCOM USB HEARTBEAT\n";
+			clock_interval_to_deadline(5, NSEC_PER_SEC, &heartbeat_deadline);
+			(void)qcom_usb_debug_enqueue(heartbeat, sizeof(heartbeat) - 1);
+		}
+		qcom_usb_debug_poll();
+		if (control_active) {
+			qcom_usb_start_reboot_once();
+		}
+		qcom_usb_worker_wait();
+	}
+
+stopped:
+	if (__atomic_load_n(&qcom_usb_worker_state, __ATOMIC_ACQUIRE) != 3u) {
+		__atomic_store_n(&qcom_usb_worker_state, 4u, __ATOMIC_RELEASE);
+	}
+	thread_bind(PROCESSOR_NULL);
+	thread_terminate_self();
+}
+
+static void
+qcom_usb_start_worker_once(void)
+{
+	thread_t thread = THREAD_NULL;
+	unsigned int expected = 0;
+	int enabled = 0;
+	kern_return_t result;
+
+	if (!PE_parse_boot_argn("qcom-usb-debug", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	if (!__atomic_compare_exchange_n(&qcom_usb_worker_state, &expected, 1u,
+	    0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	result = kernel_thread_start(qcom_usb_worker, NULL, &thread);
+	if (result == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		__atomic_store_n(&qcom_usb_worker_state, 3u, __ATOMIC_RELEASE);
+		/* A logger worker failure must never panic or abort the boot. */
+		kprintf("QCOM USB WORKER start failed kr=%d\n", result);
+	}
+}
+#endif /* XNU_QCOM_USB_DEBUG */
