# SM8735 SoC-level kernel configuration fragment (soc: namespace).
#
# [adapted] from unixnu-format2/UniXNU-sm8735-common/configs/sm8735.config, which was itself
# copied from SM8550 by the migration scaffold (the only entry was CONFIG_XNU_NATIVE_ADRENO=y).
# The SM8735 GPU is qcom,adreno-gpu-gen8-6-0, not the Adreno 740 that the catalog component
# implements, so the flag is OFF until a matching component exists (docs/GAP-LIST.md #4).
# This file is the vendored soc feed copy used through board.toml
# [kernel].config_fragments "soc:configs/sm8735.config"; configs/soc/sm8735.config is the
# matching reference copy for readers.
CONFIG_XNU_NATIVE_ADRENO=n
